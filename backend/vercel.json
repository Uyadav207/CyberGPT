{
    "version": 2,
    "builds": [
        {
            "src": "src/api/index.ts",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "src/api/index.ts"
        }
    ],
    "env": {
        "NODE_ENV": "production"
    },
    "installCommand": "npm install --legacy-peer-deps",
    "buildCommand": "bun run setup:prisma"
}